# load packages -------------
library(tidyverse)
library(here)
library(ggbeeswarm)
library(beepr)
library(RColorBrewer)
library(magick)

### setting a theme as your default
theme_set(theme_classic())

# read in cleanbeachesnew data csv
plotbeaches <- read_csv(here("data","cleanbeachesnew.csv"))

# plot bug levels using ggplot

plotbeaches %>% 
  ggplot(aes(x = year, y = beachbugs)) +
  geom_point()

# to view the number of observations across the years

plotbeaches %>%
  group_by(year) %>%
  summarise(obs = n())

# replotting bug levels by year using jitter or quasirandom

plotbeaches %>% 
  ggplot(aes(x = year, y = beachbugs)) +
  geom_jitter() #spreads the number of observations so the points are not on top of another

plotbeaches %>% 
  ggplot(aes(x = year, y = beachbugs)) +
  geom_quasirandom() #looks weird because a lot of the values are close to zero

# plot bug levels by site
plotbeaches %>%
  na.omit() %>% #used to omit any entire rows that have NA in it, so use this with caution
  ggplot(aes(x = site, y = beachbugs, color = year)) + #since ggplot was made before pipelines, it is a little hard to integrate it with ggplot, so use the old school method with '+'
  geom_jitter() +
  coord_flip() #to make the sites more readable

# turn the year to a factor instead of an integer or dbl
glimpse(plotbeaches) #running this shows that it thinks my year is a continuous integer instead of a factor, making the colors look like a scale

plotbeaches$year <- as.factor(plotbeaches$year)

# glimpse to check it did the right thing
glimpse(plotbeaches)

#then run the above pipeline again by site

# using facet wrap to loop the data into different small graphs for easy viewing -------

plotbeaches %>%
  na.omit() %>%
  ggplot(aes(x = year, y = beachbugs, colour = site)) + #check by other variables like year or council 
  geom_jitter() +
  facet_wrap(~ site)#add a coord_flip if it is better for viewability after this
#the scale of this graph is a bit off because of outliers

#combine filter and ggplot to restrict values of up to 1000
plotbeaches %>%
  na.omit() %>%
  filter(beachbugs < 1000) %>%
  ggplot(aes(x = year, y = beachbugs, colour = site)) +
  geom_jitter() +
  facet_wrap(~site)
#to use filter again to compare different sites
plotbeaches %>% 
  na.omit() %>%
  filter(beachbugs < 1000) %>%
  filter(site %in% c("Coogee Beach", "Bondi Beach"))%>%
  ggplot(aes(x = year, y = beachbugs, colour = site)) +
  geom_jitter() +
  facet_wrap(~site)

# how to get ggplots out of R ---------------
ggsave(here("output", "coogeebondi.png"))#ggsave saves the last plot that you made, use the here package to specify where to save the plot


# boxes and violins -------------

plotbeaches %>%
  na.omit() %>%
  ggplot(aes(x = site, y = logbeachbugs)) +
  geom_boxplot() +
  coord_flip()

### log helps transform the data
### violin plots show most of the data in the wide space, and the long tails are outliers
plotbeaches %>%
  na.omit() %>%
  ggplot(aes(x=year, y=logbeachbugs)) +
  geom_violin()

#filtered for buggier than average for that site = true
  plotbeaches %>%
    na.omit() %>%
    filter(buggier_site == "TRUE")%>%
  ggplot(aes(x=year, y=logbeachbugs, colour = year, fill = year)) +
    geom_violin() +
    facet_wrap(~site)

#trying a histogram with this dataset for learning purposes -----------

hist(plotbeaches$beachbugs) ###this is a fast way to eyeball the data
###histograms look at one variable only so the y variable does not need to be defined, R automatically counts it for you
plotbeaches %>%
  na.omit() %>%
  filter(site == "Clovelly Beach",
         year == "2018",
         logbeachbugs > 0) %>%
  ggplot(aes(x = logbeachbugs)) +
  geom_histogram(binwidth = 0.5) #binwidth used to adjust the default spacing

#combination of different plot types into one

plotbeaches %>%
  na.omit() %>%
  filter(buggier_site == "TRUE") %>%
  ggplot(aes(x = site, y = logbeachbugs)) +
  geom_boxplot() +
  geom_point(aes(color = year)) +
  coord_flip()

plotbeaches %>%
  na.omit() %>%
  filter(site == "Clovelly Beach") %>%
  ggplot(aes(x=year, y= logbeachbugs)) +
  geom_violin()+
  geom_quasirandom(aes(colour = buggier_site))


# plotting with geom bar and geom col ----------
### geombar is used to count observations and frequency automatically
### if the height of the bar is supposed to be the value of something then use geom col
plotbeaches %>%
  na.omit() %>%
  ggplot(aes(x = year)) +
  geom_bar() +
  facet_wrap(~ site)

plotbeaches %>%
  na.omit() %>%
  ggplot(aes(x = year, y = beachbugs)) +
  geom_col()

### check your data using summarise to verify your graph data from geom col
plotbeaches %>%
  na.omit() %>%
  group_by(year) %>%
  summarise(totalbugs = sum(beachbugs))

### always check your data before piping into ggplot, i wanted to look at year and site
plotbeaches %>%
  na.omit() %>%
  group_by(year, site) %>%
  summarise(meanbugs = mean(beachbugs)) %>%
  ggplot(aes(x = year, y = meanbugs)) +
  geom_col() +
  facet_wrap(~site)

# including error bars ------
plotbeaches %>%
  na.omit() %>%
  group_by(site) %>%
  summarise(mean = mean(beachbugs),
            sd = sd(beachbugs),
            n = n(),
            stderr = sd/sqrt(n)) %>%
  ggplot(aes(x = site, y = mean)) +
  geom_col() +
  coord_flip() +
  geom_errorbar(aes(x = site, ymin = mean-stderr, ymax = mean+stderr))


# correlating data using scatter plots with a different data set --------------
raintemp <- read_csv(here("data", "rain_temp_beachbugs.csv"))
### using geom smooth to get a best fit line

raintemp %>%
    na.omit() %>%
    filter(beachbugs > 500) %>%
    ggplot(aes(x = rain_mm, y = beachbugs, colour = temp_airport)) +
    geom_point() +
    geom_smooth ()


# how to change x in ggplot -------------

### get rid of the grey and gridlines
raintemp %>%
  na.omit() %>%
  filter(beachbugs > 500) %>%
  ggplot(aes(x = rain_mm, y = beachbugs, colour = temp_airport)) +
  geom_point() +
  geom_smooth () +
  theme_classic()

### changing the color gradient to reflect cool is blue and hot is red

raintemp %>%
  na.omit() %>%
  filter(beachbugs > 500) %>%
  ggplot(aes(x = rain_mm, y = beachbugs, colour = temp_airport)) +
  geom_point() +
  geom_smooth () +
  theme_classic() +
  scale_colour_gradient(low = "blue", high = "red")

### i installed a package called RColorBrewer at this point
### using a palette for setting colors with using scale colour distiller for a continuous gradient

display.brewer.all() ### typed this into my console to look at the the different palettes are

raintemp %>%
  na.omit() %>%
  filter(beachbugs > 500) %>%
  ggplot(aes(x = rain_mm, y = beachbugs, colour = temp_airport)) +
  geom_point() +
  geom_smooth () +
  theme_classic() +
  scale_colour_distiller(palette = "RdYlBu")

# adding titles and change axis labels ------------
### adding \n in the title where i want it to wrap around

raintemp %>%
  na.omit() %>%
  filter(beachbugs > 500) %>%
  ggplot(aes(x = rain_mm, y = beachbugs, colour = temp_airport)) +
  geom_point() +
  geom_smooth () +
  theme_classic() +
  scale_colour_distiller(palette = "RdYlBu",
                         name = "Temp (C)") +
  labs(title = "Mean enterococci bacteria levels at Eastern Suburbs beaches \n as a function of rainfall and temperature",
       subtitle = "only day > 500",
       caption = "data from https://www.environment.nsw.gov.au/beachapp/report_enterococci.aspx",
       x = "Rainfall (mm)",
       y = "Mean enterococci levels")

# adding a gif for fun --------------------------------
### install the magick package and load it

ggsave("beaches.png") ###saving my previous plot into a png

### find a gif that you like and save it as a .gif file, then read the images into R

beachplot <- image_read("beaches.png")
nocap <- image_read("capybara.gif")

### make a composite image and then use the offset to move the gif
frames <- image_composite(beachplot, nocap, offset = "+600+200")

### animate the frames and write to a new gif. Use the beepr package to alert when it is done
animation <- image_animate(frames, fps = 10)
image_write(animation, "beachcap.gif")

beep(sound = 8) #because why not lol
